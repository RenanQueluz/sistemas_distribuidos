import threading
import time

saldo = 100

def sacar(valor):
    global saldo

    saldo_atual = saldo
    time.sleep(0.01)
    saldo = saldo_atual - valor

threads = []

for i in range(10):
    t = threading.Thread(target=sacar, args=(50,))
    threads.append(t)
    t.start()
    for t in threads:
        t.join()
    print("Saldo esperado: 500")
    print("Saldo obtido", saldo)


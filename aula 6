atividade pratica de montagem do relogio

class Processo:
    def __init__(self, nome):
        self.nome = nome
        self.relogio = 0

    def evento_local(self, descricao):
        self.relogio += 1
        print(self.nome, descricao,
              "| relógio =", self.relogio)

    def enviar(self, mensagem):
        self.relogio += 1
        print(self.nome, "ENVIA:", mensagem,
              "| relógio =", self.relogio)
        return self.relogio

    def receber(self, mensagem, relogio_recebido):
        self.relogio = max(
            self.relogio,
            relogio_recebido
        ) + 1


        print(self.nome, "RECEBE:", mensagem,
              "| relógio =", self.relogio)

A = Processo("Processo A")
B = Processo("Processo B")

A.evento_local("processou pedido")
A.evento_local("validou pagamento")

B.evento_local("consultou estoque")

tempo_mensagem = A.enviar(
    "Pagamento aprovado"
)

B.receber(
    "Pagamento aprovado",
    tempo_mensagem
)

B.evento_local("reservou estoque")


# Depois de B reservar o estoque:

tempo_resposta = B.enviar(
    "Estoque reservado"
)

A.receber(
    "Estoque reservado",
    tempo_resposta
)

A.evento_local(
    "finalizou o pedido"
)


C = Processo("Processo C")

C.evento_local("gerou nota fiscal")

tempo_A_B = A.enviar("Pedido confirmado")
B.receber("Pedido confirmado", tempo_A_B)

tempo_B_C = B.enviar("Pode faturar")
C.receber("Pode faturar", tempo_B_C)

C.evento_local("enviou nota fiscal")



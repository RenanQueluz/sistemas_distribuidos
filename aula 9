PASSO 1 IMPORTANDO AS FERRAMENTAS:

import threading
import queue
import time

fila = queue.Queue()

def produtor():


    for tarefa in range(1, 7):
        print(
            "Produzindo tarefa",
            tarefa
        )
        fila.put(tarefa)
        time.sleep(0.3)


PASSO 2 CONSUMIDOR:
def consumidor(nome):
    while True:
        tarefa = fila.get()

        if tarefa is None:
            fila.task_done()
            break

        print(
            nome,
            "processando",
            tarefa
        )

        time.sleep(1)
        fila.task_done()


PASSO 3 CRIANDO OS CONSUMIDORES:

c1 = threading.Thread(
    target=consumidor,
    args=("Consumidor A",)
)

c2 = threading.Thread(
    target=consumidor,
    args=("Consumidor B",)
)

c1.start()
c2.start()



PASSO 4 EXECUTANDO O PRODUTOR:
produtor()

fila.join()

fila.put(None)
fila.put(None)

c1.join()
c2.join()

print(
    "Todas as tarefas terminaram."
)



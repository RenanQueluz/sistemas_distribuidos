PASSO 6 ADICIONANDO SEMAFORO:
limite = threading.Semaphore(2)

def tarefa_pesada(nome, numero):
    with limite:
        print(
            nome,
            "INICIOU tarefa",
            numero
        )

        time.sleep(2)

        print(
            nome,
            "FINALIZOU tarefa",
            numero
        )

PASSO 7 TESTE DE LIMITE:

threads = []

for i in range(1, 7):
    t = threading.Thread(
        target=tarefa_pesada,
        args=(f"Worker {i}", i)
    )

    threads.append(t)
    t.start()

for t in threads:
    t.join()



PASSO 1 RECURSOS COMPARTILHADOS

import threading
import time

recurso_1 = threading.Lock()
recurso_2 = threading.Lock()

print(
    "Simulacao de deadlock iniciada"
)

PASSO 2 SERVIÇO A

def servico_a():
    print("A: aguardando recurso 1")

    with recurso_1:
        print("A: obteve recurso 1")
        time.sleep(1)

        print("A: aguardando recurso 2")

        conseguiu = recurso_2.acquire(
            timeout=3
        )

PASSO 3 FINALIZANDO O SERVIÇO A

        if conseguiu:
            print("A: obteve recurso 2")
            recurso_2.release()
        else:
            print(
                "A: timeout no recurso 2"
            )

    print("A: finalizado")


PASSO 4 SERVIÇO B

def servico_b():
    print("B: aguardando recurso 2")

    with recurso_2:
        print("B: obteve recurso 2")
        time.sleep(1)

        print("B: aguardando recurso 1")

        conseguiu = recurso_1.acquire(
            timeout=3
        )
PASSO 5 FINALIZANDO SERVIÇO B

        if conseguiu:
            print("B: obteve recurso 1")
            recurso_1.release()
        else:
            print(
                "B: timeout no recurso 1"
            )

    print("B: finalizado")

PASSO 6 CRIANDO AS THREADS:

t1 = threading.Thread(
    target=servico_a
)

t2 = threading.Thread(
    target=servico_b
)

t1.start()
t2.start()

t1.join()
t2.join()


CORREÇÃO DA MESMA ORDEM DE AQUISIÇÃO:

def servico(nome):
    print(nome, "aguarda recurso 1")

    with recurso_1:
        print(nome, "obteve recurso 1")
        time.sleep(0.5)

        print(nome, "aguarda recurso 2")

        with recurso_2:
            print(
                nome,
                "obteve os dois recursos"
            )

TESTE DE DOIS SERVIÇOS:

t1 = threading.Thread(
    target=servico,
    args=("Servico A",)
)

t2 = threading.Thread(
    target=servico,
    args=("Servico B",)
)

t1.start()
t2.start()

t1.join()
t2.join()


